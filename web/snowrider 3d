<!DOCTYPE html>
<html lang="en-us">
<head>
 <meta charset="utf-8">
 <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
 <link rel="shortcut icon" href="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/TemplateData/favicon.ico">
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/TemplateData/style.css">
 <meta name="description" content="Snow Rider 3D, Snow Rider 3D Mathnook, Snow Rider 3D Unblocked">
 <meta property="og:image" content="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/snow-rider-3d.png">
 <style>
   html,body{overflow:hidden;margin:0;padding:0;width:100%;height:100%}
   .webgl-content{position:absolute;width:100%;height:100%}
   #gameContainer{width:100%;height:100%;margin:0;padding:0;border:0;position:absolute;top:0;left:0}
 </style>
</head>
<body>
 <img id="thumbnail" src="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/snow-rider-3d.png" alt="Snow Rider 3D">
 <div class="webgl-content"><div id="gameContainer"></div></div>
 <script>
   setTimeout(function(){document.getElementById("thumbnail")?.remove()},2000);
   function toggleFullscreen(){
     if(!document.fullscreenElement) document.documentElement.requestFullscreen();
     else document.exitFullscreen();
   }
   document.addEventListener("keydown",function(e){if(e.key==="f"||e.key==="F")toggleFullscreen()});
 </script>
 <script id="gamedistribution-jssdk" src="js/main.min.js?//html5.api.gamedistribution.com/main.min.js"></script>
 <script src="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/TemplateData/UnityProgress.js"></script>
 <script src="https://cdn.jsdelivr.net/gh/era6yera6y/00@main/Build/UnityLoader.js"></script>
 <script>
   var gameInstance=UnityLoader.instantiate("gameContainer","https://cdn.jsdelivr.net/gh/era6yera6y/00@main/Build/SnowRider3D-gd-1.json",{onProgress:UnityProgress,Module:{onRuntimeInitialized:function(){UnityProgress.Clear()}}});
 </script>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width,initial-scale=1">
 <title>Paper.io</title>
 <style>
   html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:system-ui,sans-serif}
   #fr{display:none;width:100%;height:100%;border:0}
   #load{position:absolute;top:10%;left:50%;transform:translateX(-50%);z-index:2;padding:10px 22px;border:2px solid #fff;border-radius:10px;background:#000;color:#fff;font:700 24px cursive;cursor:pointer}
   #load:hover{background:#083b00}
   #status{position:absolute;inset:0;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#123c2b,#2eb872 55%,#b8ef65);font-size:clamp(2rem,8vw,6rem);font-weight:900;font-style:italic}
 </style>
</head>
<body>
 <div id="status">PAPER.IO</div>
 <iframe id="fr" allowfullscreen></iframe>
 <button id="load" type="button">Load Game</button>
 <script>
   const DB_NAME = "GameCacheDB";
   const STORE_NAME = "GameFiles";
   const CACHE_DURATION = 90 * 24 * 60 * 60 * 1000;
   const FILE_URL = "https://cdn.jsdelivr.net/gh/centerclassroom/mc55@main/paper-io-2.xml";

   function openDB() {
     return new Promise((resolve, reject) => {
       const request = indexedDB.open(DB_NAME, 1);
       request.onupgradeneeded = event => event.target.result.createObjectStore(STORE_NAME, {keyPath:"url"});
       request.onsuccess = event => resolve(event.target.result);
       request.onerror = () => reject(request.error);
     });
   }

   async function getFileFromCache(url) {
     const db = await openDB();
     const cached = await new Promise((resolve, reject) => {
       const request = db.transaction(STORE_NAME, "readonly").objectStore(STORE_NAME).get(url);
       request.onsuccess = () => resolve(request.result);
       request.onerror = () => reject(request.error);
     });
     if (cached && Date.now() - cached.timestamp < CACHE_DURATION) return cached.content;
     const response = await fetch(url);
     if (!response.ok) throw new Error("Game file could not be loaded");
     const content = await response.text();
     await new Promise((resolve, reject) => {
       const request = db.transaction(STORE_NAME, "readwrite").objectStore(STORE_NAME).put({url, content, timestamp:Date.now()});
       request.onsuccess = resolve;
       request.onerror = () => reject(request.error);
     });
     return content;
   }

   document.getElementById("load").addEventListener("click", async event => {
     const button = event.currentTarget;
     const frame = document.getElementById("fr");
     try {
       button.textContent = "Loading...";
       const text = await getFileFromCache(FILE_URL);
       frame.srcdoc = text;
       frame.style.display = "block";
       document.getElementById("status").style.display = "none";
       button.style.display = "none";
     } catch (error) {
       console.error("Error loading Paper.io:", error);
       button.textContent = "Try Again";
       alert("The game could not be loaded. Check your internet connection.");
     }
   });

   document.addEventListener("keydown", event => {
     if (event.key.toLowerCase() === "f") {
       if (!document.fullscreenElement) document.documentElement.requestFullscreen?.();
       else document.exitFullscreen?.();
     }
   });
 </script>
</body>
</html>

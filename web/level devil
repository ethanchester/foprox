<!doctype html>
<html lang="en">
<head>
 <base href="https://cdn.jsdelivr.net/gh/bubbls/UGS-Assets@2ac7e5b354322a207bd059768f928ece8c9471c1/level%20devil/">
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
 <title>Level Devil</title>
 <link rel="shortcut icon" type="image/png" href="./favicon.png">
 <script src="./poki-sdk.js"></script>
 <script src="./Level Devil.js"></script>
 <style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#000;touch-action:none}#openfl-content{width:100%;height:100%}</style>
</head>
<body>
 <noscript>Please enable JavaScript to play Level Devil.</noscript>
 <div id="openfl-content"></div>
 <script>
   document.addEventListener("touchmove", event => event.preventDefault(), {passive:false});
   function toggleFullscreen(){document.fullscreenElement ? document.exitFullscreen?.() : document.documentElement.requestFullscreen?.()}
   document.addEventListener("keydown", event => {if(event.key.toLowerCase()==="f") toggleFullscreen();});
   lime.embed("Level Devil", "openfl-content", 854, 480, {parameters:{}});
 </script>
</body>
</html>

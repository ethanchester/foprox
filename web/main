 <script>
   const pageFullscreen = document.getElementById("pageFullscreen");
   const search = document.getElementById("gameSearch");
   const cards = [...document.querySelectorAll(".game-card")];


   function updateFullscreenButton() {
     const isFullscreen = document.fullscreenElement === document.body;
     pageFullscreen.textContent = isFullscreen ? "⛶ Exit fullscreen" : "⛶ Fullscreen";
     pageFullscreen.setAttribute("aria-label", isFullscreen ? "Exit fullscreen" : "Enter fullscreen");
   }


   pageFullscreen.addEventListener("click", async (event) => {
     event.preventDefault();
     try {
       if (document.fullscreenElement) {
         await document.exitFullscreen();
       } else {
         const requestFullscreen = document.documentElement.requestFullscreen;
         if (requestFullscreen) await requestFullscreen.call(document.documentElement);
       }
     } catch (error) {
       console.warn("Fullscreen is not available.", error);
     }
   });


   document.addEventListener("fullscreenchange", updateFullscreenButton);
   const noResults = document.getElementById("noResults");
   search.addEventListener("input", () => {
     const query = search.value.trim().toLowerCase();
     let visible = 0;
     cards.forEach(card => { const matches = card.dataset.game.includes(query); card.hidden = !matches; if (matches) visible++; });
     noResults.style.display = visible ? "none" : "block";
   });


   function popup() {
     const tab = window.open("about:blank", "_blank");
     if (!tab) alert("Popup blocked. Please allow pop-ups for this site.");
     return tab;
   }



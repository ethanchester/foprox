<!doctype html>
<html lang="en">
<head>
 <base href="https://cdn.jsdelivr.net/gh/bubbls/UGS-Assets@main/ovomod/">
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
 <title>OvO</title>
 <link rel="manifest" href="appmanifest.json">
 <link rel="shortcut icon" href="icon-256.png">
 <link rel="apple-touch-icon" href="icon-256.png">
 <style>
   *{margin:0;padding:0}
   html,body{width:100%;height:100%;overflow:hidden;background:#000;color:#fff;touch-action:none}
   canvas{display:block;touch-action:none}
   #c2canvasdiv{width:100vw;height:100vh}
   #c2canvas{width:100%;height:100%}
 </style>
 <link rel="stylesheet" href="animate.css">
 <link rel="stylesheet" href="hmmg_layoutTransition.css">
 <link rel="stylesheet" href="jquery.gritter.css">
</head>
<body>
 <div id="fb-root"></div>
 <div id="c2canvasdiv">
   <canvas id="c2canvas" width="640" height="640">Your browser does not support HTML5 Canvas.</canvas>
 </div>

 <script src="jquery-3.4.1.min.js"></script>
 <script>
   (function () {
     const OriginalImage = window.Image;
     window.Image = function () {
       const image = new OriginalImage();
       image.crossOrigin = "anonymous";
       return image;
     };
     const originalCreateElement = document.createElement.bind(document);
     document.createElement = function (tagName) {
       const element = originalCreateElement(tagName);
       if (tagName.toLowerCase() === "img") element.crossOrigin = "anonymous";
       return element;
     };
   })();
 </script>
 <script src="GameAnalytics.js"></script>
 <script src="Tween.js"></script>
 <script src="html2canvas.min.js"></script>
 <script src="jquery.gritter.js"></script>
 <script src="howler.js"></script>
 <script src="c7runtime.js"></script>
 <script>
   if (window.jQuery) {
     jQuery(function () {
       if (typeof cr_createRuntime === "function") cr_createRuntime("c2canvas");
       else console.error("OvO runtime failed to load.");
     });
   }

   function onVisibilityChanged() {
     if (typeof cr_setSuspended === "function") cr_setSuspended(document.hidden);
   }
   document.addEventListener("visibilitychange", onVisibilityChanged);

   window.C2_RegisterSW = function () {
     if (!navigator.serviceWorker) return;
     navigator.serviceWorker.register("sw.js", {scope: "./"})
       .then(registration => console.log("Service worker registered:", registration.scope))
       .catch(error => console.warn("Service worker registration failed:", error));
   };
 </script>
 <script>
   var VERSION = VERSION || (function () {
     return {
       version: function () { return "CTLE"; },
       skinVersion: function () { return "1.4.5"; },
       replayVersion: function () { return "1.4.4"; }
     };
   })();
 </script>
 <script src="https://cdn.jsdelivr.net/gh/Arjun99ab/ovo@main/src/modloaders/modloader.js" id="modloader" type="module" defer></script>
</body>
</html>

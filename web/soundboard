<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width,initial-scale=1">
 <title>Meme Soundboard</title>
 <style>
   *{box-sizing:border-box}
   body{margin:0;padding:1rem;background:#1a1a1a;color:#fff;font-family:system-ui,sans-serif;overflow-x:hidden}
   .container{max-width:1200px;margin:auto}
   h1{text-align:center;margin-bottom:2rem}
   .sound-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem}
   .sound-btn{padding:1rem;background:#333;border:1px solid #555;border-radius:8px;color:#fff;font-size:1rem;cursor:pointer;transition:all 0.2s}
   .sound-btn:hover{background:#444;border-color:#777}
   .sound-btn:active{transform:scale(0.95);background:#222}
 </style>
</head>
<body>
 <div class="container">
   <h1>Meme Soundboard</h1>
   <div class="sound-grid" id="soundGrid"></div>
 </div>
 <script>
   const sounds = [
     ["Vine Boom", "vine-boom.mp3"], ["Tuco Get Out", "tuco-get-out.mp3"],
     ["Discord Notification", "discord-notification.mp3"], ["Anime Wow", "anime-wow.mp3"],
     ["Metal Pipe Clang", "metal-pipe.mp3"], ["Emotional Damage", "emotional-damage.mp3"],
     ["Fart Sound", "fart.mp3"], ["Light Skin Scare", "rizz.mp3"],
     ["Sad Meow", "sad-meow.mp3"], ["Lack of Father Figure", "father-figure.mp3"],
     ["Punch Sound", "punch.mp3"], ["Error Sound", "windows-error.mp3"],
     ["Yippee", "yippee.mp3"], ["Ding", "ding.mp3"], ["Taco Bell Bong", "taco-bell.mp3"],
     ["Dun Dun Dunnn", "dun-dun-dun.mp3"], ["Ack", "ack.mp3"], ["Mac Quack", "mac-quack.mp3"],
     ["Discord Call", "discord-call.mp3"], ["Bone Crack", "bone-crack.mp3"], ["Mario Jump", "mario-jump.mp3"],
     ["Womp Womp", "womp.mp3"], ["MLG Air Horn", "air-horn.mp3"], ["Pluh", "pluh.mp3"],
     ["Gulp", "gulp.mp3"], ["Lagging", "lagging.mp3"], ["Huh Cat", "huh-cat.mp3"],
     ["Heavenly Music", "heavenly.mp3"], ["Discord Leave", "discord-leave.mp3"], ["Pedro Song", "pedro.mp3"],
     ["YouTube UwU", "youtube-uwu.mp3"], ["Snoring Meme", "snoring.mp3"], ["Ta-da", "ta-da.mp3"],
     ["Money", "money.mp3"], ["Mouse Click", "mouse-click.mp3"], ["Bonk Doge", "bonk.mp3"],
     ["Noooo", "noooo.mp3"], ["Another One", "dj-khaled.mp3"], ["Yeet", "yeet.mp3"],
     ["Low Taper Fade", "imagine-if-ninja-got-a-low-taper-fade.mp3"], ["SpongeBob Fail", "spongebob-fail.mp3"],
     ["Sigma Boy Bass", "sigma-boy-bass-boosted-caca.mp3"], ["Among Us Sus", "among-us-role-reveal-sound.mp3"],
     ["Bruh", "movie_1.mp3"], ["Sad Meow Song", "sad-meow-song.mp3"], ["Flashbang", "flashbanggg.mp3"],
     ["Hello There", "obi-wan_says_hello_thereyoutubetomp4.mp3"], ["Gas Gas Gas", "gas-gas-gaslqshort.mp3"],
     ["Fail", "fail-sound-effect.mp3"], ["Rap God", "eminem-rap-god.mp3"], ["Mustaaaaaaaard", "kendrick-mustard.mp3"]
   ];
   const base = "https://www.myinstants.com/media/sounds/";
   const grid = document.getElementById("soundGrid");
   
   sounds.forEach(([name, file]) => {
     const button = document.createElement("button");
     button.className = "sound-btn";
     button.textContent = name;
     button.onclick = () => {
       const audio = new Audio(base + file);
       audio.play().catch(e => console.error("Could not play:", name, e));
     };
     grid.appendChild(button);
   });
 </script>
</body>
</html>

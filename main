<script>
const games=[
 ['OvO','platformer action','Master momentum and leap through tricky levels.','https://raw.githubusercontent.com/CoolDude2349/Offline-HTML-Games-Pack/refs/heads/master/offline/ovo.html'],
 ['Minecraft','building sandbox adventure','Build, explore, and survive in a blocky sandbox.','https://raw.githubusercontent.com/CoolDude2349/Offline-HTML-Games-Pack/refs/heads/master/offline/1.12.html'],

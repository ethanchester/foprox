<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Foprox</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      padding: 24px;
      position: relative;
      overflow-x: hidden;
      background: #26003f;
      color: #fff;
      font-family: system-ui, sans-serif;
    }
    .lava-blob {
      position: fixed;
      z-index: 0;
      border-radius: 50%;
      filter: blur(22px);
      opacity: .62;
      pointer-events: none;
      animation: lavaFloat var(--duration) ease-in-out infinite alternate;
    }
    header, main {
      position: relative;
      z-index: 1;
    }
    @keyframes lavaFloat {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(var(--move-x), var(--move-y)) scale(1.22); }
      100% { transform: translate(calc(var(--move-x) * -0.7), calc(var(--move-y) * 1.4)) scale(.86); }
    }
    header {
      display: flex;
      gap: 12px;
      max-width: 900px;
      margin: 0 auto 24px;
    }
    input, button {
      border: 0;
      border-radius: 8px;
      padding: 10px 12px;
      font: inherit;
    }
    input { min-width: 0; flex: 1; }
    button {
      background: #fff;
      color: #5b1290;
      cursor: pointer;
      font-weight: 700;
    }
    button:hover { background: #ead8ff; }
    main { max-width: 900px; margin: auto; }
    #grid, #offline {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 14px;
    }
    article {
      padding: 16px;
      border: 1px solid #ffffff35;
      border-radius: 12px;
      background: #ffffff18;
      box-shadow: 0 4px 14px #24003b45;
    }
    h3 { margin: 0 0 14px; }
    article button { margin: 3px 2px 0 0; }
    article input { width: 100%; margin-bottom: 8px; }
    section { margin-top: 28px; }
    h2 { margin-bottom: 12px; }
    @media (max-width: 520px) {
      body { padding: 16px; }
      header { flex-direction: column; }
    }
  </style>
</head>
<body>
  <header>
    <button id="full">⛶ Fullscreen</button>
    <input id="search" type="search" placeholder="Search games...">
  </header>
  <main id="games">
    <div id="grid"></div>
    <p id="none" hidden>No games found.</p>
  </main>
  <script>
    const blobColors = ['#a238ff', '#ff3cac', '#7024ff', '#e83cff', '#c026d3'];
    const blobCount = 3 + Math.floor(Math.random() * 5);

    for (let i = 0; i < blobCount; i++) {
      const blob = document.createElement('div');
      const size = 22 + Math.random() * 42;
      blob.className = 'lava-blob';
      blob.style.width = `${size}vw`;
      blob.style.height = `${size}vw`;
      blob.style.left = `${Math.random() * 100 - 15}vw`;
      blob.style.top = `${Math.random() * 100 - 10}vh`;
      blob.style.background = blobColors[Math.floor(Math.random() * blobColors.length)];
      blob.style.setProperty('--duration', `${11 + Math.random() * 12}s`);
      blob.style.setProperty('--move-x', `${-20 + Math.random() * 40}vw`);
      blob.style.setProperty('--move-y', `${-12 + Math.random() * 30}vh`);
      blob.style.animationDelay = `${Math.random() * -12}s`;
      document.body.appendChild(blob);
    }

    const base = 'https://raw.githubusercontent.com/CoolDude2349/Offline-HTML-Games-Pack/refs/heads/master/offline/';
    const games = [
      ['OvO','platformer action','ovo.html'],
      ['Minecraft','building sandbox adventure','1.12.html'],
      ['Geometry Dash','rhythm platformer music action','geometry-dash-lite.html'],
      ['Paper.io','arcade io territory action','paper-io-2.htm'],
      ['Cookie Clicker','idle cookies tapping strategy','cookie-clicker.htm'],
      ['Level Devil','platformer difficult troll action','level-devil.html'],
      ['Escape Road 2','driving racing car arcade','escape-road-2.html'],
      ['Spacebar Clicker','idle clicking keyboard arcade','spacebar-clicker.html'],
      ['Snow Rider 3D','snow racing winter driving','https://cdn.jsdelivr.net/gh/era6yera6y/00@main/index.html'],
      ['2048','puzzle numbers strategy arcade','2048.html'],
      ['Among Us','impostor social deduction multiplayer','among-us.html'],
      ['Baldi’s Basics','school math horror adventure','baldis-basics.html'],
      ['Backrooms','horror escape liminal maze','backrooms.html'],
      ['BitLife','life simulator choices career','bitlife.html'],
      ['Drive Mad','driving racing car obstacle','drive-mad.htm'],
      ['Granny','hide find mystery horror','granny.html']
    ].map(([name,tags,url]) => ({name,tags,url:url.startsWith('http') ? url : base + url}));

    const $ = id => document.getElementById(id);
    const grid = $('grid');
    const escape = text => text.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    grid.innerHTML = games.map((game, i) => `
      <article data-search="${escape((game.name + ' ' + game.tags).toLowerCase())}">
        <h3>${escape(game.name)}</h3>
        <button data-url="${escape(game.url)}">Play</button>
        <button class="download" data-download="${escape(game.url)}">Download</button>
      </article>`).join('') + `
      <article data-search="custom url github html game">
        <h3>Custom URL Game</h3>
        <input id="name" type="text" placeholder="Game name">
        <input id="url" type="url" placeholder="https://raw.githubusercontent.com/...">
        <button id="open">Open →</button>
        <button id="downloadCustom">Download</button>
      </article>`;

    const openGame = async (url, name = 'Game') => {
      const win = open('', '_blank');
      if (!win) return alert('Popup blocked.');
      win.document.write(`<p>Loading ${escape(name)}...</p>`);
      try {
        const html = await (await fetch(url)).text();
        win.document.open();
        win.document.write(html);
        win.document.close();
      } catch {
        win.document.body.innerHTML = '<p>The game could not be loaded.</p>';
      }
    };

    const db = new Promise((resolve, reject) => {
      const request = indexedDB.open('FoproxGames', 1);
      request.onupgradeneeded = () => request.result.createObjectStore('games', {keyPath: 'name'});
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
    const store = (mode, action) => db.then(database => new Promise((resolve, reject) => {
      const transaction = database.transaction('games', mode);
      const request = action(transaction.objectStore('games'));
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    }));
    const downloads = document.createElement('section');
    downloads.innerHTML = '<h2>Offline games</h2><div id="offline"></div>';
    $('games').append(downloads);
    const renderDownloads = async () => {
      const saved = await store('readonly', games => games.getAll());
      $('offline').innerHTML = saved.map(({name}) =>
        `<article><b>${escape(name)}</b> <button data-run="${escape(name)}">Run</button> <button data-delete="${escape(name)}">Delete</button></article>`
      ).join('') || '<p>No downloaded games.</p>';
    };
    renderDownloads();

    grid.onclick = async event => {
      const button = event.target.closest('button');
      if (!button) return;
      const name = button.parentElement.querySelector('h3').textContent;
      if (button.dataset.url) openGame(button.dataset.url, name);
      if (button.dataset.download) {
        if (!confirm('Download this game for offline use?')) return;
        try {
          const response = await fetch(button.dataset.download);
          if (!response.ok) throw Error();
          const html = await response.text();
          await store('readwrite', games => games.put({name, html}));
          renderDownloads();
        } catch {
          alert('The game could not be downloaded.');
        }
      }
    };

    $('offline').onclick = async event => {
      const button = event.target.closest('button');
      if (!button) return;
      const name = button.dataset.run || button.dataset.delete;
      if (button.dataset.run) {
        const saved = await store('readonly', games => games.get(name));
        const win = open('', '_blank');
        if (win && saved) win.document.write(saved.html);
      } else {
        await store('readwrite', games => games.delete(name));
        renderDownloads();
      }
    };

    const customURL = () => {
      try {
        const url = new URL($('url').value.trim());
        if (url.protocol === 'https:' && url.hostname.includes('githubusercontent.com')) return url.href;
      } catch {}
      alert('Enter a secure raw GitHub URL.');
    };

    const customName = () => {
      const name = $('name').value.trim();
      if (name) return name;
      alert('Enter a name for the custom game.');
    };

    $('open').onclick = () => {
      const name = customName();
      const url = customURL();
      if (name && url) openGame(url, name);
    };

    $('downloadCustom').onclick = async () => {
      const name = customName();
      const url = customURL();
      if (!name || !url || !confirm('Download this game for offline use?')) return;
      try {
        const response = await fetch(url);
        if (!response.ok) throw Error();
        const html = await response.text();
        await store('readwrite', games => games.put({name, html}));
        renderDownloads();
      } catch {
        alert('The game could not be downloaded.');
      }
    };

    $('search').oninput = ({target}) => {
      const query = target.value.toLowerCase();
      let shown = 0;
      grid.querySelectorAll('article').forEach(card => {
        card.hidden = !card.dataset.search.includes(query);
        shown += !card.hidden;
      });
      $('none').hidden = shown > 0;
    };

    $('full').onclick = () => document.fullscreenElement
      ? document.exitFullscreen()
      : document.documentElement.requestFullscreen?.();
  </script>
</body>
</html>

const grid=document.getElementById('gameGrid');
const esc=s=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function card([name,tags,desc,url],i){return `<article class="game-card" data-game="${esc((name+' '+tags).toLowerCase())}"><div class="game-art art-${i%6}">${esc(name.toUpperCase())}</div><div class="card-content"><div class="card-top"><h3>${esc(name)}</h3><span class="badge">Online</span></div><p>${esc(desc)}</p><button class="play-button" data-url="${esc(url)}">Play ${esc(name)} →</button></div></article>`}
grid.innerHTML=games.map(card).join('')+`<article class="game-card" data-game="custom url github html code game"><div class="game-art art-2">CUSTOM<br>URL</div><div class="card-content"><div class="card-top"><h3>Custom URL Game</h3><span class="badge">HTML</span></div><p>Paste a raw GitHub HTML URL to open or save your own browser game.</p><input class="custom-url-input" id="customUrl" type="url" placeholder="https://raw.githubusercontent.com/..." autocomplete="off"><button class="play-button" id="openCustom">Open Custom Game →</button><button class="play-button" id="download" style="margin-top:8px;background:linear-gradient(100deg,#168caa,#54d9ff)">Download Offline →</button><div class="status" id="status" role="status"></div><div class="offline-games"><b>Downloaded games</b><div class="offline-game-list" id="offlineList"></div></div></div></article><div id="noResults">No games found. Try another search.</div>`;
const $=id=>document.getElementById(id), status=$('status');
function popup(){const w=open('about:blank','_blank');if(!w)alert('Popup blocked. Please allow pop-ups for this site.');return w}
function valid(){try{const u=new URL($('customUrl').value.trim());if(u.protocol==='https:'&&u.hostname.includes('githubusercontent.com'))return u}catch{}status.textContent='Enter a secure raw GitHub URL.';status.className='status error'}
async function source(url){const r=await fetch(url);if(!r.ok)throw Error();return r.text()}
function openSource(url,name='Game'){const w=popup();if(!w)return;w.document.write(`<p style="font-family:system-ui;padding:2rem">Loading ${esc(name)}...</p>`);source(url).then(s=>{w.document.open();w.document.write(s);w.document.close()}).catch(()=>{w.document.body.innerHTML='<p style="font-family:system-ui;padding:2rem">The game could not be loaded.</p>'})}
grid.addEventListener('click',e=>{const b=e.target.closest('[data-url]');if(!b)return;const g=games.find(x=>x[3]===b.dataset.url);if(b.dataset.url==='local'){alert('This game is built into the original launcher.');return}if(b.dataset.url==='sounds'){alert('Soundboard requires its original audio assets.');return}openSource(b.dataset.url,g?.[0])});
$('openCustom').onclick=()=>{const u=valid();if(u)openSource(u.href,'custom game')};
const DB='foprox-offline-games',STORE='games';function db(){return new Promise((ok,no)=>{const r=indexedDB.open(DB,1);r.onupgradeneeded=e=>e.target.result.createObjectStore(STORE,{keyPath:'url'});r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}
async function all(){const d=await db();return new Promise((ok,no)=>{const r=d.transaction(STORE).objectStore(STORE).getAll();r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}
async function save(game){const d=await db();return new Promise((ok,no)=>{const r=d.transaction(STORE,'readwrite').objectStore(STORE).put(game);r.onsuccess=ok;r.onerror=()=>no(r.error)})}
async function remove(url){const d=await db();d.transaction(STORE,'readwrite').objectStore(STORE).delete(url)}
async function render(){const list=$('offlineList'),items=await all();list.innerHTML=items.length?'':'<span class="empty">No games downloaded yet.</span>';items.forEach((g,i)=>{const row=document.createElement('div');row.className='offline-game';row.innerHTML=`<span class="offline-game-name">${esc(g.name)}</span><span class="offline-game-actions"><button data-run="${i}">Run</button><button data-delete="${i}">Delete</button></span>`;list.append(row)});list.items=items}
$('download').onclick=async()=>{if(!confirm('Are you sure? This is VERY laggy and may use a lot of browser storage.'))return;const u=valid();if(!u)return;status.textContent='Downloading...';try{await save({url:u.href,name:decodeURIComponent(u.pathname.split('/').pop()||'Offline Game'),source:await source(u.href)});status.textContent='Downloaded. Saved in this browser.';render()}catch{status.textContent='Not enough browser storage or the download failed.';status.className='status error'}};
$('offlineList').onclick=async e=>{const items=e.currentTarget.items,g=items[e.target.dataset.run??e.target.dataset.delete];if(!g)return;if(e.target.dataset.run!==undefined){const w=popup();if(w){w.document.open();w.document.write(g.source);w.document.close()}}else{await remove(g.url);render()}};
$('gameSearch').oninput=e=>{const q=e.target.value.toLowerCase(),cards=[...grid.querySelectorAll('.game-card')];let n=0;cards.forEach(c=>{const yes=c.dataset.game.includes(q);c.hidden=!yes;if(yes)n++});$('noResults').style.display=n?'none':'block'};
$('fullscreen').onclick=()=>document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen?.();render();
</script>

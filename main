  </head>
  <body>
    <main>
      <h1>Offline HTML Games</h1>
      <p>Choose a game to load it. Only one game is kept open at a time.</p>
      <form id="gameForm">
        <label for="gameName">Game name:</label>
        <input id="gameName" type="search" list="gameOptions" autocomplete="off" placeholder="Search for a game" />
        <datalist id="gameOptions"></datalist>
        <button type="submit">Load game</button>
      </form>
      <p id="status" role="status">Loading game list…</p>
    </main>

    <script>
      const REPOSITORY = "CoolDude2349/Offline-HTML-Games-Pack";
      const BRANCH = "master";
      const API_URL = `https://api.github.com/repos/${REPOSITORY}/git/trees/${BRANCH}?recursive=1`;
      const RAW_BASE = `https://raw.githubusercontent.com/${REPOSITORY}/${BRANCH}/`;

      const gameOptions = document.getElementById("gameOptions");
      const gameName = document.getElementById("gameName");
      const gameForm = document.getElementById("gameForm");
      const status = document.getElementById("status");
      let games = [];
      let gameWindow = null;

      function populateGameOptions() {
        const fragment = document.createDocumentFragment();
        for (const game of games) {
          const option = document.createElement("option");
          option.value = game.name;
          fragment.append(option);
        }
        gameOptions.replaceChildren(fragment);
        status.textContent = `${games.length} games available. Search by name, then choose Load game.`;
      }

      async function loadGame(game) {
        if (gameWindow && !gameWindow.closed) gameWindow.close();
        gameWindow = window.open("", "_blank");
        if (!gameWindow) {
          status.textContent = "The new tab was blocked. Allow pop-ups to open games.";
          return;
        }

        status.textContent = `Loading ${game.name}…`;
        gameWindow.document.title = "School Work";

        const url = RAW_BASE + game.path.split("/").map(encodeURIComponent).join("/");
        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error(`GitHub returned ${response.status}`);

          let html = await response.text();
          const baseTag = `<base href="${url}">`;
          if (/<base\b[^>]*>/i.test(html)) {
            html = html.replace(/<base\b[^>]*>/i, baseTag);
          } else if (/<head\b[^>]*>/i.test(html)) {
            html = html.replace(/<head\b[^>]*>/i, (head) => `${head}${baseTag}`);
          } else {
            html = `${baseTag}${html}`;
          }

          if (/<title\b[^>]*>[\s\S]*?<\/title\s*>/i.test(html)) {
            html = html.replace(/<title\b[^>]*>[\s\S]*?<\/title\s*>/i, "<title>School Work</title>");
          } else {
            html = html.replace(/<head\b[^>]*>/i, (head) => `${head}<title>School Work</title>`);
          }

          const faviconUrl = "https://raw.githubusercontent.com/ethanchester/foprox/refs/heads/main/canvaas.png";
          html = html.replace(/<link\b[^>]*>/gi, (tag) => {
            const rel = tag.match(/\brel\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))/i);
            return rel && /\bicon\b/i.test(rel[1] || rel[2] || rel[3]) ? "" : tag;
          });
          const faviconTag = `<link rel="icon" href="${faviconUrl}">`;
          if (/<head\b[^>]*>/i.test(html)) {
            html = html.replace(/<head\b[^>]*>/i, (head) => `${head}${faviconTag}`);
          } else {
            html = `${faviconTag}${html}`;
          }

          gameWindow.document.open();
          gameWindow.document.write(html);
          gameWindow.document.close();
          gameWindow.document.title = "Wake Id Portal";

          const gameHead = gameWindow.document.head || gameWindow.document.createElement("head");
          for (const icon of gameHead.querySelectorAll('link[rel~="icon"]')) icon.remove();
          const gameFavicon = gameWindow.document.createElement("link");
          gameFavicon.rel = "icon";
          gameFavicon.type = "image/png";
          gameFavicon.href = "https://raw.githubusercontent.com/ethanchester/foprox/refs/heads/main/canvaas.png";
          gameHead.append(gameFavicon);
          status.textContent = `Now playing: ${game.name} (new tab)`;
        } catch (error) {
          if (!gameWindow.closed) {
            gameWindow.document.body.textContent = `Could not load ${game.name}: ${error.message}`;
          }
          status.textContent = `Could not load ${game.name}: ${error.message}`;
        }
      }

      gameForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const requested = gameName.value.trim().toLowerCase();
        const game = games.find((item) => item.name.toLowerCase() === requested);
        if (!game) {
          status.textContent = "Choose a game from the suggestions or enter its exact name.";
          return;
        }
        loadGame(game);
      });

      fetch(API_URL, { headers: { Accept: "application/vnd.github+json" } })
        .then((response) => {
          if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
          return response.json();
        })
        .then((tree) => {
          if (tree.truncated) throw new Error("GitHub returned an incomplete file list.");
          games = tree.tree
            .filter((entry) => entry.type === "blob" && /^offline\/.*\.html?$/i.test(entry.path))
            .map((entry) => ({
              path: entry.path,
              name: entry.path.slice("offline/".length).replace(/\.html?$/i, "").replace(/[\/_-]+/g, " ")
            }))
            .sort((a, b) => a.name.localeCompare(b.name));

          if (!games.length) {
            status.textContent = "No HTML games were found in the offline folder.";
            return;
          }
          populateGameOptions();
        })
        .catch((error) => {
          status.textContent = `Could not load the game list: ${error.message}. Check your connection or GitHub availability.`;
        });
    </script>
  </body>
</html>

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offline HTML Games</title>
    <link rel="icon" href="https://raw.githubusercontent.com/ethanchester/foprox/refs/heads/main/canvaas.png" />
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, sans-serif;
        color: #182235;
        background: #f2f6fc;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        padding: 4rem 1.25rem;
        line-height: 1.6;
        background: radial-gradient(circle at top left, #e1ebff, transparent 38rem), #f2f6fc;
      }

      main {
        max-width: 42rem;
        margin: 0 auto;
        padding: clamp(1.5rem, 5vw, 3rem);
        border: 1px solid #e0e7f1;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 1.25rem 3rem rgb(32 55 90 / 10%);
      }

      h1 {
        margin: 0 0 0.5rem;
        color: #173a71;
        font-size: clamp(2rem, 6vw, 2.75rem);
        line-height: 1.15;
        letter-spacing: -0.04em;
      }

      main > p:first-of-type {
        margin: 0 0 1.75rem;
        color: #5e6b7e;
      }

      form {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.65rem;
        align-items: end;
      }

      label {
        grid-column: 1 / -1;
        margin-bottom: -0.45rem;
        font-size: 0.9rem;
        font-weight: 650;
      }

      input,
      button {
        min-height: 2.9rem;
        border-radius: 0.65rem;
        font: inherit;
      }

      input {
        width: 100%;
        padding: 0.65rem 0.85rem;
        border: 1px solid #cbd5e3;
        background: #fff;
        color: inherit;
      }

      input:focus-visible {
        border-color: #3975d5;
        outline: 3px solid rgb(57 117 213 / 20%);
      }

      button {
        padding: 0.65rem 1rem;
        border: 0;
        background: #2864bd;
        color: #fff;
        font-weight: 650;
        cursor: pointer;
        transition: background-color 150ms ease, transform 150ms ease;
      }

      button:hover {
        background: #1c4f9c;
      }

      button:active {
        transform: translateY(1px);
      }

